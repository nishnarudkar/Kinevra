# Copy to .env and fill in. Never commit .env. No secrets in code or git.
# AWS credentials come from an SSO profile, not keys in this file.
AWS_PROFILE=kinevra-dev
AWS_REGION=

# Overrides for configs/*.yaml (see kinevra/config.py ENV_OVERRIDES)
KINEVRA_SIDE=right
KINEVRA_LLM_PROVIDER=bedrock
KINEVRA_LLM_MODEL_ID=
KINEVRA_LLM_REGION=
KINEVRA_STORAGE_BACKEND=local
KINEVRA_BUCKET=
KINEVRA_TABLE=
KINEVRA_LOG_LEVEL=INFO
